# Express keep-alive (Render sets PORT automatically)
PORT=3000

# ZM API (Instagram, Twitter/X, Weibo, Xiaohongshu, Threads, Pinterest, Douyin)
ZM_API_BASE_URL=https://api.zm.io.vn/v1
ZM_API_KEY=your_zm_api_key_here

# CapCut
CAPCUT_API_BASE_URL=https://jonellccapisprojectv2-a62001f39859.herokuapp.com/api/capcut

# TikTok (tikwm)
TIKTOK_API_BASE_URL=https://www.tikwm.com/api/

# ── Appstate qua JSONBin.io (khuyên dùng trên Render) ──
# 1. Tạo bin tại https://jsonbin.io — paste nội dung appstate.json (mảng JSON)
# 2. Bin → Private → copy Bin ID + Master Key
JSONBIN_BIN_ID=your_bin_id_here
JSONBIN_MASTER_KEY=your_master_key_here

# Hoặc dùng URL đầy đủ (tùy chọn, thay cho BIN_ID):
# APPSTATE_SYNC_URL=https://api.jsonbin.io/v3/b/<binId>/latest
# APPSTATE_SYNC_API_KEY=your_master_key

APPSTATE_SYNC_ENABLED=true
APPSTATE_SYNC_INTERVAL=15
APPSTATE_SYNC_ENABLE_PERIODIC=true

# Fallback local / Render (nếu không dùng JSONBin):
# APPSTATE=[{"key":"...","value":"...","domain":".facebook.com",...}]
